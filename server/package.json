{
  "name": "no-last-train-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:prepare && node scripts/next-with-env.mjs dev",
    "build": "next build",
    "build:next": "next build",
    "test": "tsx --test src/lib/*.test.ts",
    "start": "node scripts/next-with-env.mjs start",
    "db:prepare": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "data:demand": "node scripts/build-demand-profile.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "ioredis": "^6.0.0",
    "next": "^15.0.0",
    "nodemailer": "^9.0.4",
    "openai": "^7.4.0",
    "pg": "^8.22.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
