{
  "name": "no-last-train",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w no-last-train-client",
    "dev:logs": "node scripts/dev-logs.mjs",
    "dev:client": "npm run dev -w no-last-train-client",
    "dev:server": "npm run dev -w no-last-train-server",
    "build": "npm run build -w no-last-train-client",
    "build:client": "npm run build -w no-last-train-client",
    "build:server": "npm run build -w no-last-train-server",
    "test": "npm run test -w no-last-train-server && tsx --test client/test/congestion.test.ts client/test/map-profile.test.ts client/test/mobility.test.ts client/test/vehicle-motion.test.ts client/test/line-badges.test.ts client/test/day-night.test.ts && node --test scripts/*.test.mjs",
    "start:client": "npm run start -w no-last-train-client",
    "start:server": "npm run start -w no-last-train-server",
    "lint": "npm run lint -w no-last-train-client",
    "preview": "npm run preview -w no-last-train-client",
    "db:prepare": "npm run db:prepare -w no-last-train-server",
    "db:generate": "npm run db:generate -w no-last-train-server",
    "db:push": "npm run db:push -w no-last-train-server",
    "db:seed": "npm run db:seed -w no-last-train-server",
    "data:demand": "npm run data:demand -w no-last-train-server",
    "data:map": "npm run data:map -w no-last-train-server"
  }
}
